{
  "name": "@algosail/plykit",
  "version": "0.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algosail/plykit.git"
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./workers": {
      "workerd": "./dist/workers/mod.js",
      "types": "./dist/workers/mod.d.ts",
      "default": "./dist/workers/mod.js"
    },
    "./build": {
      "types": "./dist/build/mod.d.ts",
      "default": "./dist/build/mod.js"
    },
    "./node": {
      "types": "./dist/node/mod.d.ts",
      "default": "./dist/node/mod.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --test test/*_test.ts",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint . --fix",
    "demo": "node --watch test/fixture/serve.ts"
  },
  "dependencies": {
    "@algosail/ply": "^0.1.3",
    "@algosail/plydom": "^0.1.1",
    "@algosail/plyfuture": "^0.1.1",
    "@algosail/plystream": "^0.1.2",
    "csstype": "^3.2.3",
    "esbuild": "^0.25.10"
  },
  "devDependencies": {
    "@algosail/eslint-config": "^0.3.0",
    "@types/node": "^24.7.0",
    "eslint": "^10.12.0",
    "happy-dom": "^15.11.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
